{
	"schemaVersion": 1,
	"id": "dyables",
	"version": "${version}",
	"name": "Extra Dyables",
	"description": "Adds dyed variants to the bookshelf, workbench, glass, seat, and bed.",
	"authors": [
		"Horiuchi"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/extra-dyables-bta",
		"sources": "https://github.com/horiuchii/minecraft-bta-dyables"
	},
	"icon": "icon.png",
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"horiuchi.dyables.DyablesMod"
		],
		"beforeGameStart": [
			"horiuchi.dyables.DyablesMod"
		],
		"afterGameStart": [
			"horiuchi.dyables.DyablesMod"
		],
		"recipesReady": [
			"horiuchi.dyables.DyablesMod"
		],
		"initModels": [
			"horiuchi.dyables.DyablesModels"
		]
	},
	"mixins": [
		"dyables.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}"
	}
}
